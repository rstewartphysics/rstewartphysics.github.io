---
layout: none
permalink: /search/manifest.json
sitemap: false
---
{
  "exclude": {{ site.data.search.exclude | jsonify }},
  "pages": [
{%- for p in site.html_pages %}
    {"url": {{ p.url | jsonify }}, "title": {{ p.search_title | default: p.title | jsonify }}, "skip": {% if p.search == false or p.sitemap == false %}true{% else %}false{% endif %}, "keywords": {{ p.search_keywords | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ]
}
